#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = ". :";
            bindings = <&kp PERIOD>, <&kp COLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = ", :";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
       &kp B       &kp L             &kp D           &kp W        &kp Z        &kp SINGLE_QUOTE  &kp F        &kp O            &kp U              &kp J
       &hm LGUI N  &hm LEFT_SHIFT R  &hm LEFT_ALT T  &hm LCTRL S  &kp G        &kp Y             &hm RCTRL H  &hm RIGHT_ALT A  &hm RIGHT_SHIFT E  &hm RGUI I
&none  &kp Q       &kp X             &kp M           &kp C        &kp V        &kp K             &kp P        &dot_colon       &comma_semi        &kp SLASH   &none
                                     &kp ESCAPE      &lt 1 SPACE  &lt 4 TAB    &lt 3 ENTER       &lt 2 BSPC   &kp DELETE
            >;
        };

        Nav {
            bindings = <
       &none           &kp LA(NUMBER_3)  &kp LA(NUMBER_2)  &kp LA(NUMBER_3)  &none        &none     &kp PG_DN       &kp UP_ARROW    &kp PG_UP        &none
       &kp LEFT_SHIFT  &kp LA(NUMBER_4)  &kp LA(NUMBER_5)  &kp LA(NUMBER_6)  &kp LA(F)    &kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END
&none  &none           &kp LA(N7)        &kp LA(N8)        &kp LA(N9)        &kp LA(V)    &none     &none           &none           &none            &none    &none
                                         &none             &none             &none        &none     &none           &none
            >;
        };

        Num {
            bindings = <
       &kp LS(PIPE)  &kp N1  &kp N2     &kp N3  &kp LS(STAR)    &trans  &trans  &trans  &trans  &trans
       &kp FSLH      &kp N4  &kp N5     &kp N6  &kp MINUS       &trans  &trans  &trans  &trans  &trans
&none  &kp BSLH      &kp N7  &kp N8     &kp N9  &kp EQUAL       &trans  &trans  &trans  &trans  &trans  &trans
                             &kp COMMA  &kp N0  &kp DOT         &trans  &trans  &trans
            >;
        };

        Sym {
            bindings = <
       &kp LS(PRCNT)  &kp LS(AT)     &kp LS(TILDE)  &kp LS(LBRC)   &kp LS(RBRC)    &trans  &trans  &trans  &trans  &trans
       &kp LS(POUND)  &kp LS(CARET)  &kp LS(DLLR)   &kp LS(LPAR)   &kp LS(RPAR)    &trans  &trans  &trans  &trans  &trans
&none  &kp LS(QMARK)  &kp LS(EXCL)   &kp GRAVE      &kp LBKT       &kp RBKT        &trans  &trans  &trans  &trans  &trans  &trans
                                     &kp LS(LT)     &kp LS(UNDER)  &kp LS(GT)      &trans  &trans  &trans
            >;
        };

        Func {
            bindings = <
                &kp F10  &kp F1  &kp F2  &kp F3  &none     &trans  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &trans
                &kp F11  &kp F4  &kp F5  &kp F6  &none     &trans  &trans             &trans           &trans      &trans
&studio_unlock  &kp F12  &kp F7  &kp F8  &kp F9  &none     &trans  &trans             &trans           &trans      &trans  &trans
                                 &trans  &trans  &trans    &trans  &trans             &trans
            >;
        };
    };
};
